# Local-only defaults. Replace all secrets outside local development.
DAAIF_INTERNAL_CONTEXT_SECRET=change-me-with-at-least-32-random-characters

# Optional OpenAI-compatible internal AI gateway. No data rows are sent.
DAAIF_AI_GATEWAY_BASE_URL=
DAAIF_AI_GATEWAY_API_KEY=
DAAIF_AI_GATEWAY_MODEL=sql-optimizer

# Public host ports for Docker Compose.
DAAIF_FRONTEND_PORT=8080
DAAIF_API_PORT=8000
DAAIF_MCP_PORT=8002

